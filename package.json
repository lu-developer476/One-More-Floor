{
  "name": "one-more-floor",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:text-only": "node scripts/check-text-only.mjs",
    "check:levels": "vitest run src/levels/LevelValidation.test.ts",
    "check:version": "node scripts/check-version.mjs",
    "validate": "npm run check:text-only && npm run check:version && npm run check:ui && npm run check:levels && npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test e2e/preview.spec.ts",
    "test:e2e:preview": "npm run test:e2e:smoke",
    "test:deployed": "playwright test e2e/deployed.spec.ts",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
